    {
      "id": 7,
      "type": "timeseries",
      "title": "Thermostat setpoint vs actual",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "taphome_setpoint_celsius",
          "legendFormat": "{{name}} setpoint"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "taphome_temperature_celsius and on(device_id) taphome_setpoint_celsius",
          "legendFormat": "{{name}} actual"
